# Copy this file to .env.local and fill in the values, then restart `npm run dev`.
# On Vercel: Project → Settings → Environment Variables, then redeploy.

# ======================================================================
# AI chat assistant — any OpenAI-compatible API. Pick ONE option.
# ======================================================================

# Option 1 — Groq (FREE, very fast, no card needed)
#   1. Sign in at https://console.groq.com
#   2. API Keys → Create API Key → paste it below
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=

# Option 2 — Google Gemini (FREE tier)
#   Key: https://aistudio.google.com/apikey
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash
# AI_API_KEY=

# Option 3 — OpenAI (paid)
#   Key: https://platform.openai.com/api-keys
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=

# ======================================================================
# Contact form — configure Telegram, email, or both.
# ======================================================================

# Telegram (FREE)
#   1. Open @BotFather in Telegram → /newbot → copy the token.
#   2. Open your new bot and press Start (send it any message).
#   3. Open https://api.telegram.org/bot<TOKEN>/getUpdates
#      and copy the number from "chat":{"id": 123456789 ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via Resend (FREE: 3,000 emails/month)
#   1. Sign up at https://resend.com with the email you want to receive messages on.
#   2. API Keys → Create API Key → paste it below.
#   Without a verified domain Resend only delivers to your own account email,
#   which is exactly what a contact form needs.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional, only after verifying your own domain in Resend:
# CONTACT_FROM_EMAIL=Portfolio <hello@yourdomain.com>
